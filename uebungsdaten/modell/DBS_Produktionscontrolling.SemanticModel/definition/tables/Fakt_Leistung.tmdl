table Fakt_Leistung
	lineageTag: 1aa228f2-5aa4-5ea9-9007-abc7b5c72554

	measure 'Ist Kosten' = SUM ( Fakt_Leistung[Ist_Kosten] )
		formatString: #,0 €
		lineageTag: 48a884d4-cc7d-5c02-a8cb-6b412117efdd

	measure 'Plan Kosten' = SUM ( Fakt_Leistung[Plan_Kosten] )
		formatString: #,0 €
		lineageTag: ceb26c5e-29bd-5ea1-810a-7fa160aa6d85

	measure 'Abw Kosten' = [Ist Kosten] - [Plan Kosten]
		formatString: #,0 €
		lineageTag: 9650a378-9219-5134-b28c-025c3c21ccee

	measure 'Abw Kosten %' = ( [Ist Kosten] - [Plan Kosten] ) / [Plan Kosten]
		formatString: 0.0 %
		lineageTag: aa7712dd-5f2b-5c8a-b282-5e3a3bae2831

	measure 'Ist Stunden' = SUM ( Fakt_Leistung[Ist_Stunden] )
		formatString: #,0
		lineageTag: 3a852af0-985d-5047-8e45-046fb45d840e

	measure 'Plan Stunden' = SUM ( Fakt_Leistung[Plan_Stunden] )
		formatString: #,0
		lineageTag: d54ddf4c-70e7-56ce-847f-41c16ee053ad

	measure 'Kosten je Stunde' = DIVIDE ( [Ist Kosten], [Ist Stunden] )
		formatString: #,0 €
		lineageTag: 56ed86b5-0b4d-5e66-8880-d694e0487aa2

	measure Produktivitaet = DIVIDE ( SUM ( Fakt_Leistung[Leistungseinheiten] ), [Ist Stunden] )
		formatString: 0.00
		lineageTag: 820735a3-80bf-5f9e-9775-b81be06b79a6

	measure m_QQ = DIVIDE ( SUM ( Fakt_Leistung[Qualitaet_Bestanden] ), SUM ( Fakt_Leistung[Qualitaet_Pruefungen] ) )
		formatString: 0.0 %
		lineageTag: 6c47485c-8972-52a6-9227-157889c4ffb8

	measure Krankenquote = SUM ( Fakt_Leistung[Krankheitstage] ) / SUM ( Fakt_Leistung[Sollarbeitstage] )
		formatString: 0.0 %
		lineageTag: d151221e-4d1b-5319-a5b2-ab5cecc0621a

	measure Ueberstundenquote = DIVIDE ( SUM ( Fakt_Leistung[Ueberstunden] ), [Ist Stunden] )
		formatString: 0.0 %
		lineageTag: 22e8ee97-4b11-54cb-8343-6e10b637f24f

	measure 'Ist Kosten VJ' = CALCULATE ( [Ist Kosten], SAMEPERIODLASTYEAR ( Kalender[Datum] ) )
		formatString: #,0 €
		lineageTag: 2b362f73-fcf0-5989-8f58-a2438c920f82

	measure 'Abw VJ %' = DIVIDE ( [Ist Kosten] - [Ist Kosten VJ], [Ist Kosten VJ] )
		formatString: 0.0 %
		lineageTag: bf2b9c32-13e9-5a3a-8db5-ca54434f0ba4

	measure 'Kosten YTD' = TOTALYTD ( [Ist Kosten], Fakt_Leistung[Monat] )
		formatString: #,0 €
		lineageTag: b97f11ec-1dd0-52e8-96c9-0ea54b86e0fa

	measure 'Massnahmen offen' = CALCULATE ( COUNTROWS ( Massnahmen ), Massnahmen[Status] <> "abgeschlossen" )
		formatString: #,0
		lineageTag: 98db3b96-9f19-5992-80df-54e71f5a1aa9

	measure 'Einsparung Ist' = SUM ( Massnahmen[Einsparung_Ist] )
		formatString: #,0 €
		lineageTag: 3d94c07a-13bf-58e3-8a0f-ce64c2e92a98

	measure 'Einsparung Zielerreichung' = DIVIDE ( [Einsparung Ist], SUM ( Massnahmen[Einsparung_Plan] ) )
		formatString: 0.0 %
		lineageTag: dd756d2b-eda7-51d2-9452-d31d9741099e

	measure 'KPI Status Text' =
			IF (
			    ( SUM ( Fakt_Leistung[Ist_Kosten] ) - SUM ( Fakt_Leistung[Plan_Kosten] ) ) / SUM ( Fakt_Leistung[Plan_Kosten] ) > 0.05
			        && DIVIDE ( SUM ( Fakt_Leistung[Qualitaet_Bestanden] ), SUM ( Fakt_Leistung[Qualitaet_Pruefungen] ) ) < 0.9,
			    "kritisch",
			    IF (
			        ( SUM ( Fakt_Leistung[Ist_Kosten] ) - SUM ( Fakt_Leistung[Plan_Kosten] ) ) / SUM ( Fakt_Leistung[Plan_Kosten] ) > 0.05
			            || DIVIDE ( SUM ( Fakt_Leistung[Qualitaet_Bestanden] ), SUM ( Fakt_Leistung[Qualitaet_Pruefungen] ) ) < 0.9
			            || SUM ( Fakt_Leistung[Krankheitstage] ) / SUM ( Fakt_Leistung[Sollarbeitstage] ) > 0.08,
			        "beobachten",
			        IF (
			            CALCULATE ( COUNTROWS ( Massnahmen ), Massnahmen[Status] = "verzögert" ) > 0,
			            "Maßnahme verzögert",
			            "im Plan"
			        )
			    )
			)
		lineageTag: 699e424a-6fef-5c07-8f0f-cfd74474dd8f

